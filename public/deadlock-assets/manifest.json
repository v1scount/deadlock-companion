{
  "version": 1,
  "root": "/deadlock-assets",
  "layout": {
    "portrait": "heroes/{hero_id}/portrait.webp",
    "icon": "abilities/{ability_class_name}/icon.webp",
    "clip": "abilities/{ability_class_name}/clip.webm",
    "schematic": "schematics/{ability_class_name}.json"
  },
  "how_to_add_hero": [
    "1. Pick hero_id from GET /v1/assets/heroes (or /v1/assets/heroes/{id}).",
    "2. mkdir -p public/deadlock-assets/heroes/{id} public/deadlock-assets/abilities/<class_name>",
    "3. Run: npm run assets:pull -- --hero {id}   (downloads portrait + ability icons).",
    "4. For each signature ability, copy a schematic JSON from an existing shape and edit hints.",
    "5. Append the hero block to this manifest (portrait + 4 abilities with icon/schematic paths).",
    "6. Optional clips: npm run assets:pull-clips -- --hero {id} (or curl CDN videos/hero_abilities/*.webm).",
    "Budget: under 15 minutes once you know the ability class_names."
  ],
